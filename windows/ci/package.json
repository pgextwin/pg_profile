{
  "schemaVersion": 1,
  "distribution": "sql-only",
  "files": [
    {
      "source": "upstream",
      "path": "pg_profile.control",
      "destination": "share/extension/pg_profile.control",
      "targets": [
        "install",
        "zip"
      ]
    },
    {
      "source": "upstream",
      "path": "pg_profile--*.sql",
      "destination": "share/extension/{fileName}",
      "targets": [
        "install",
        "zip"
      ],
      "expectedCount": 2,
      "requiredMatches": [
        "pg_profile--{version}.sql",
        "pg_profile--4.15--4.16.sql"
      ]
    },
    {
      "source": "license",
      "path": "LICENSE",
      "destination": "LICENSE",
      "targets": [
        "zip"
      ]
    },
    {
      "source": "upstream",
      "path": "README.md",
      "destination": "UPSTREAM-README.md",
      "targets": [
        "zip"
      ],
      "optional": true
    }
  ],
  "packageInfo": [
    "pg_profile Windows package",
    "==============================",
    "",
    "Upstream repository: {upstreamRepository}",
    "Upstream ref:        {upstreamRef}",
    "Upstream commit:     {upstreamCommit}",
    "pg_profile version: {version}",
    "SQL default_version: {version}",
    "PostgreSQL major:    {pgMajor}",
    "PostgreSQL tested:   {pgTested}",
    "Architecture:        {architecture}",
    "Compiler:            not-applicable",
    "License:             PostgreSQL-style; see LICENSE",
    "",
    "This is an unofficial pgextwin Windows package built from the official pg_profile source.",
    "pg_profile is a SQL-only extension. Requires dblink and plpgsql."
  ]
}
